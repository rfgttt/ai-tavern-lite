# Copy to .env.production. Never commit the real file.
DOMAIN=tavern.example.com

# Built-in single-user HTTP Basic authentication.
AI_TAVERN_AUTH_USERNAME=admin
AI_TAVERN_AUTH_PASSWORD=replace-with-at-least-12-random-characters

# Model configuration. Keep Mock enabled until the real values are ready.
AI_TAVERN_MOCK_LLM=true
AI_TAVERN_PROVIDER_NAME=OpenAI Compatible
AI_TAVERN_BASE_URL=
AI_TAVERN_API_KEY=
AI_TAVERN_MODEL=

# Optional strict allowlist. Example: api.openai.com,api.deepseek.com
# Empty means any DNS host is accepted only when every resolved address is public.
AI_TAVERN_LLM_ALLOWED_HOSTS=

AI_TAVERN_DEFAULT_USERNAME=用户
AI_TAVERN_MAX_UPLOAD_SIZE_MB=20
AI_TAVERN_MAX_JSON_BODY_BYTES=2097152
AI_TAVERN_MAX_REQUEST_BODY_BYTES=25165824
AI_TAVERN_RATE_LIMIT_REQUESTS=180
AI_TAVERN_RATE_LIMIT_WINDOW_SECONDS=60
AI_TAVERN_AI_RATE_LIMIT_REQUESTS=12
AI_TAVERN_AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_TAVERN_MAX_CONCURRENT_GENERATIONS=2
