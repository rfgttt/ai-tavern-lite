# AI Tavern Lite Environment Variables
# Copy this file to .env and fill in your values

# LLM Settings (optional - UI settings take precedence if set)
AI_TAVERN_BASE_URL=
AI_TAVERN_API_KEY=
AI_TAVERN_MODEL=
AI_TAVERN_PROVIDER_NAME=OpenAI Compatible

# Set to true for testing without an API key
AI_TAVERN_MOCK_LLM=true

# Default user name
AI_TAVERN_DEFAULT_USERNAME=用户

# Server settings
AI_TAVERN_HOST=127.0.0.1
AI_TAVERN_PORT=8000

# Database (default: sqlite)
AI_TAVERN_DATABASE_URL=sqlite:///./data/ai_tavern.db

# Max upload size in MB
AI_TAVERN_MAX_UPLOAD_SIZE_MB=20
