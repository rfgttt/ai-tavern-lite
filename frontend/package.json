{
  "name": "ai-tavern-lite-frontend",
  "private": true,
  "version": "2.2.0-preview.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "npm run test:run:ui && npm run test:run:store",
    "test:typecheck": "tsc -p tsconfig.vitest.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "check": "npm run test:typecheck && npm run test:run && npm run build",
    "test:run:ui": "vitest run tests/components tests/api tests/lib",
    "test:run:store": "vitest run tests/stores"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.2",
    "rehype-sanitize": "^6.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
