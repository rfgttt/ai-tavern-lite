{$DOMAIN} {
    encode zstd gzip

    reverse_proxy app:8000 {
        # SSE must be flushed immediately instead of buffered.
        flush_interval -1
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }

    header {
        -Server
    }
}
